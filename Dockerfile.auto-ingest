FROM python:3.12-slim

ARG CODEX_VERSION=0.145.0

WORKDIR /workspace

# Install Node + Codex CLI for the default codex-cli ingest backend.
# Git/ripgrep let Codex inspect the disposable proposal context efficiently.
RUN apt-get update && apt-get install -y curl ca-certificates gnupg git ripgrep && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g "@openai/codex@${CODEX_VERSION}" && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements-auto-ingest.txt /opt/labs-wiki/requirements.txt
RUN pip install --no-cache-dir -r /opt/labs-wiki/requirements.txt

COPY --chmod=755 scripts/auto_ingest.py scripts/watch_raw.py scripts/audit_synthesis.py /opt/labs-wiki/scripts/
COPY --chmod=755 scripts/ingest_transaction.py scripts/wiki_schema.py /opt/labs-wiki/scripts/
COPY --chmod=755 scripts/checkpoint_classifier.py scripts/checkpoint_state.py /opt/labs-wiki/scripts/
COPY --chmod=755 scripts/compile_index.py /opt/labs-wiki/scripts/
COPY --chmod=755 wiki-graph-api/graph_builder.py /opt/labs-wiki/scripts/graph_builder.py
# Build context may contain operator-private prompt modes (for example 0600).
# Runtime workers run under the configured non-root PUID, so normalize read access.
COPY --chmod=644 scripts/prompts/ /opt/labs-wiki/scripts/prompts/
COPY --chmod=644 templates/ /opt/labs-wiki/templates/
RUN chmod -R a+rX /opt/labs-wiki/scripts/prompts /opt/labs-wiki/templates

ENV PROJECT_ROOT=/workspace
ENV WIKI_RUNTIME_SCRIPT_ROOT=/opt/labs-wiki/scripts
ENV PYTHONUNBUFFERED=1
ENV WIKI_INGEST_BACKEND=codex-cli
# Codex needs writable HOME/CODEX_HOME for auth/config/session/cache state.
# Container runs as uid 1000 (set via compose), so create a dedicated writable
# home outside /app (which may be hidden by the project bind mount) and outside
# /tmp (Codex refuses to install helper shims under temp dirs).
ENV HOME=/home/codex
ENV CODEX_HOME=/home/codex
RUN mkdir -p /home/codex/.cache && \
    chown -R 1000:1000 /home/codex && \
    chmod 700 /home/codex /home/codex/.cache

CMD ["python3", "/opt/labs-wiki/scripts/watch_raw.py"]
