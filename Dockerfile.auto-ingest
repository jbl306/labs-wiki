FROM python:3.12-slim

WORKDIR /app

# Install Node + Codex CLI for the default codex-cli ingest backend.
# Git/ripgrep are useful to Codex when it inspects and edits the mounted repo.
RUN apt-get update && apt-get install -y curl ca-certificates gnupg git ripgrep && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g @openai/codex && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements-auto-ingest.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/auto_ingest.py scripts/watch_raw.py /app/scripts/
COPY scripts/checkpoint_classifier.py scripts/checkpoint_state.py /app/scripts/
COPY scripts/compile_index.py /app/scripts/
COPY scripts/prompts/ /app/scripts/prompts/
COPY templates/ /app/templates/

ENV PROJECT_ROOT=/app
ENV PYTHONUNBUFFERED=1
ENV WIKI_INGEST_BACKEND=codex-cli
# Codex needs writable HOME/CODEX_HOME for auth/config/session/cache state.
# Container runs as uid 1000 (set via compose), so create a dedicated writable
# home outside /app (which may be hidden by the project bind mount) and outside
# /tmp (Codex refuses to install helper shims under temp dirs).
ENV HOME=/home/codex
ENV CODEX_HOME=/home/codex
RUN mkdir -p /home/codex/.cache && \
    chmod -R 777 /home/codex

CMD ["python3", "scripts/watch_raw.py"]
